PORT=4000

# Native development: purchasing uses MongoDB transactions, so this must point
# to a writable replica-set member (rs0 here) or a MongoDB sharded cluster.
MONGODB_URI=mongodb://localhost:27017/mittho_ops?replicaSet=rs0

# Docker Compose uses its internal rs0 member by default. Set this only when the
# Compose API should use an external transaction-capable MongoDB deployment.
COMPOSE_MONGODB_URI=

# Use at least 32 random characters. The placeholder is rejected in production;
# START-WINDOWS.bat replaces it automatically when it creates a local .env.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact browser origins, without paths. Keep 5173 for native
# development and 8080 for the default same-origin Docker web endpoint. Replace
# these with the public HTTPS origin for production (for example,
# https://ops.example.com).
CLIENT_URL=http://localhost:5173,http://localhost:8080

# Deployment class: development | test | staging | production.
# NODE_ENV alone cannot express staging (build tooling only understands
# "production" or not), so APP_ENV is the explicit deployment class and wins
# when set. staging and production are hardened identically: CLIENT_URL becomes
# mandatory, https is enforced for non-loopback origins, and the permissive
# development CORS fallback is unavailable. An unrecognised value is refused.
APP_ENV=development

# How many reverse proxies sit in front of this API, counted outwards.
#   unset        -> loopback  (safe default: only a same-host proxy is trusted)
#   1            -> the nginx in client/nginx.conf (the Docker Compose topology)
#   false / 0    -> no proxy; req.ip is the socket peer
#   loopback | uniquelocal | 10.0.0.0/8, ...   -> passed to Express verbatim
# true and * are REJECTED at startup: they make the caller's own
# X-Forwarded-For authoritative, letting anyone forge their rate-limit identity.
# Only raise this if you genuinely add another proxy/load balancer in front.
TRUST_PROXY=1

# ── Online payments (Phase 8B) ───────────────────────────────────────────────
# sandbox | production. Defaults to sandbox everywhere except production.
# Production refuses to start with PAYMENT_MODE=sandbox, or with eSewa's
# published sandbox credentials.
PAYMENT_MODE=sandbox

# Absolute URL the gateway redirects the guest back to. Defaults to the first
# CLIENT_URL origin. Must be reachable by the customer's browser.
PAYMENT_RETURN_BASE_URL=

# Outbound HTTP deadline for gateway calls, milliseconds. Default 15000.
PAYMENT_HTTP_TIMEOUT_MS=

# eSewa ePay v2. In sandbox these fall back to eSewa's own published test
# credentials (EPAYTEST), so eSewa works locally with no configuration.
# In production BOTH must be your real merchant values.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# Khalti ePayment v2. Khalti publishes no usable shared sandbox key, so Khalti
# is simply not offered to guests until this is set. Value is the raw key; the
# code adds the "Key " prefix.
KHALTI_SECRET_KEY=

# ── Phase 16A: scheduled reorder sweep ───────────────────────────────────────
# Disabled by default. The scheduler is an IN-PROCESS interval timer: if you run
# more than one API container, every container will tick. That is safe for alert
# CORRECTNESS (a unique partial index collapses duplicates to one alert per
# condition) but multiplies read load, and `lastRun` telemetry is per-process.
# Supply a distributed lock via setSchedulerLock() before scaling horizontally.
REORDER_SCHEDULER_ENABLED=false
REORDER_SCHEDULER_INTERVAL_MINUTES=60
REORDER_SCHEDULER_LOOKBACK_DAYS=30
